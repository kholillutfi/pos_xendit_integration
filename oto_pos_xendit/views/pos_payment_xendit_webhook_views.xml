<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_xendit_webhook_tree" model="ir.ui.view">
        <field name="name">pos.payment.xendit.webhook.tree</field>
        <field name="model">pos.payment.xendit.webhook</field>
        <field name="arch" type="xml">
            <tree string="Xendit Webhook Logs">
                <field name="transaction_id"/>
                <field name="received_at"/>
            </tree>
        </field>
    </record>

    <record id="view_pos_payment_xendit_webhook_form" model="ir.ui.view">
        <field name="name">pos.payment.xendit.webhook.form</field>
        <field name="model">pos.payment.xendit.webhook</field>
        <field name="arch" type="xml">
            <form string="Xendit Webhook Log">
                <sheet>
                    <group>
                        <group>
                            <field name="transaction_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="received_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Response">
                            <group>
                                <field name="body" widget="ace" options="{'mode': 'python'}" nolabel="1" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_payment_xendit_webhook" model="ir.actions.act_window">
        <field name="name">Webhook Log</field>
        <field name="res_model">pos.payment.xendit.webhook</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem
        id="menu_pos_payment_xendit_webhook"
        name="Webhook Log"
        parent="oto_pos_xendit.menu_pos_payment_xendit_root"
        action="action_pos_payment_xendit_webhook"
        sequence="20"
        groups="oto_pos_xendit.group_pos_xendit_manager"/>
</odoo>
